# Copy to .env (gitignored) and adjust. Read by pydantic-settings and by `make`.
S3_ENDPOINT_URL=http://s3.192.168.1.202.nip.io:8080
S3_ACCESS_KEY=mlops
S3_SECRET_KEY=mlops-minio-secret
MLFLOW_TRACKING_URI=http://mlflow.192.168.1.202.nip.io:8080
MLFLOW_DISABLE_AGENT_HINT=1
# The MLflow server hands out presigned MinIO URLs for multipart transfers, built
# from ITS endpoint (minio.storage.svc...), unresolvable outside the cluster.
# Clients outside k8s must stream through the server instead:
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false
